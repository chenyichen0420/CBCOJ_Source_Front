<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= contest ? contest.title : '比赛' %> - LZJOJ</title>
    <link rel="stylesheet" href="/assets/base.css">
    <link rel="stylesheet" href="/assets/components.css">
    <link rel="stylesheet" href="/assets/layout.css">
    <script src="/assets/marked.min.js"></script>
    <script src="/assets/katex.min.js"></script>
    <script src="/assets/auto-render.min.js"></script>
    <script src="/assets/purify.min.js"></script>
    <style>
        .contest-info { background: var(--bg-secondary); padding: 20px; border-radius: 8px; margin-bottom: 20px; }
        .contest-title { font-size: 1.8rem; margin-bottom: 10px; }
        .contest-time { color: var(--text-secondary); margin-bottom: 15px; }
        .contest-description { margin-top: 15px; padding-top: 15px; border-top: 1px solid var(--border); }
        .problem-table { width: 100%; border-collapse: collapse; }
        .problem-table th, .problem-table td { padding: 10px; border-bottom: 1px solid var(--border); text-align: left; }
        .problem-table th { background: var(--bg-secondary); }
        .rank-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .rank-table th, .rank-table td { padding: 8px; border-bottom: 1px solid var(--border); }
        .contest-status {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
        }
        .status-not-started { background: #ff9800; color: #fff; }
        .status-running { background: #4caf50; color: #fff; }
        .status-ended { background: #9e9e9e; color: #fff; }
        .btn-submit {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 5px 12px;
            border-radius: 4px;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-submit:hover:not(:disabled) { opacity: 0.8; }
        /* 使用全局 .modal / .modal-content 样式 */
        textarea.code-area {
            width: 100%; height: 300px; font-family: monospace;
            background: var(--bg-secondary); border: 1px solid var(--border);
            color: var(--text-primary); padding: 8px; resize: vertical;
        }
        .modal-actions { margin-top: 10px; text-align: right; }
        .modal-actions button { margin-left: 8px; }
        .language-select {
            margin: 15px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .language-select select {
            padding: 6px 10px;
            border-radius: 4px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border);
        }
        .empty-list {
            text-align: center;
            color: var(--text-secondary);
            padding: 20px;
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav-left"><%- navigation %></div>
        <div class="nav-right">
            <div class="login-content">
                <div id="login-area"></div>
                <div id="login-status">
                    <div class="status-indicator" id="statusIndicator"></div>
                    <span id="statusText">正在检测登录状态...</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="page">
        <div class="container">
            <div id="contest-content">
                <!-- 比赛基本信息 -->
                <% 
                    const now = new Date();
                    const start = new Date(contest.start_time);
                    const end = new Date(contest.end_time);
                    let statusClass = '', statusText = '';
                    if (now < start) { statusClass = 'status-not-started'; statusText = '未开始'; }
                    else if (now >= start && now <= end) { statusClass = 'status-running'; statusText = '进行中'; }
                    else { statusClass = 'status-ended'; statusText = '已结束'; }
                    const isRunningOrEnded = now >= start; // 允许提交的条件：比赛已开始
                %>
                <div class="contest-info" data-start-time="<%= contest.start_time %>" data-end-time="<%= contest.end_time %>">
                    <div class="contest-title"><%= contest.title %></div>
                    <div class="contest-time">开始: <%= new Date(contest.start_time).toLocaleString() %> | 结束: <%= new Date(contest.end_time).toLocaleString() %></div>
                    <div><span class="contest-status <%= statusClass %>" id="contestStatusBadge"><%= statusText %></span></div>
                    <div class="contest-description"><script type="text/plain" class="raw-markdown"><%= contest.description || '' %></script></div>
                </div>

                <div class="problem-list">
                    <h2>题目列表</h2>
                    <table class="problem-table">
                        <thead><tr><th>#</th><th>题目编号</th><th>标题</th><th>时间限制</th><th>内存限制</th></tr></thead>
                        <tbody>
                            <% problems.forEach((p, idx) => { %>
                                <tr>
                                    <td><%= idx+1 %></td>
                                    <td><%= p.pid %></td>
                                    <td><a href="/problem/<%= p.pid %>?contestId=<%= contest.id %>" target="_blank"><%= p.title %></a></td>
                                    <td><%= p.timelm %> ms</td>
                                    <td><%= p.memlm %> KB</td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                
                <div class="rank-section">
                    <h2>排行榜</h2>
                    <table class="rank-table">
                        <thead><tr><th>排名</th><th>用户名</th><th>通过题目数</th></tr></thead>
                        <tbody id="rankTbody">
                            <% if (rank && rank.length > 0) {
                                rank.forEach((user, idx) => { %>
                                    <tr><td><%= idx+1 %></td><td><img src="/api/avatar/<%= encodeURIComponent(user.username) %>" class="avatar"> <%= user.username %></td><td><%= user.solved %></td></tr>
                                <% });
                            } else { %>
                                <tr><td colspan="3">暂无数据</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <style>
        .katex-html[aria-hidden="true"] { display: none; }
        .problem-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 16px; }
        .problem-title-section { flex: 1; min-width: 300px; }
        .problem-limits-section { display: flex; flex-direction: column; gap: 8px; text-align: right; min-width: 200px; }
        .limit-item { padding: 8px 12px; background: rgba(255,255,255,.05); border-radius: 10px; border: 1px solid rgba(255,255,255,.1); font-size: 14px; color: var(--muted); }
        @media (max-width:768px) {
            .problem-header { flex-direction: column; }
            .problem-limits-section { text-align: left; flex-direction: row; justify-content: space-between; }
        }
    </style>
    <script type="text/javascript" src="/assets/checklogin.min.js"></script>
    <script src="/assets/markdown-renderer.js"></script>
    <script>
	document.addEventListener("DOMContentLoaded", () => {
	if (typeof renderMathInElement !== 'undefined') {
	    renderMathInElement(document.getElementById('problem-content') || document.body, {
		delimiters: [
		    {left: '$$', right: '$$', display: true},
		    {left: '$', right: '$', display: false},
		    {left: '\\(', right: '\\)', display: false},
		    {left: '\\[', right: '\\]', display: true}
		],
		throwOnError: false
	    });
	} else {
	    console.warn('auto-render not loaded, formula may not display');
	}
	});
        const contestId = "<%= contest.id%>";
        const startTimeStr = "<%= contest.start_time %>";
        const endTimeStr = "<%= contest.end_time %>";
        const isRunningOrEnded = <%= isRunningOrEnded %>;

        async function refreshRanking() {
            if (!contestId) return;
            try {
                const resp = await fetch(`/api/contests/${contestId}/rank`);
                const data = await resp.json();
                if (data.status === 'Y' && Array.isArray(data.rank)) {
                    const tbody = document.getElementById('rankTbody');
                    if (tbody) {
                        if (data.rank.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="3" class="empty-list">暂无排名数据</td></tr>';
                        } else {
                            let html = '';
                            data.rank.forEach((user, idx) => {
                                html += `<tr><td>${idx+1}</td><td>${escapeHtml(user.username)}</td><td>${user.solved || 0}</td></tr>`;
                            });
                            tbody.innerHTML = html;
                        }
                    }
                }
            } catch(err) {
                console.warn('刷新排行榜失败', err);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        document.addEventListener('DOMContentLoaded', async () => {
            setInterval(() => {
                refreshRanking();
            }, 30000);

            // 移除页面级提交按钮，用户请在题目页面使用提交表单（支持 contestId 模式）
            await refreshRanking();
        });
    </script>
</body>
</html>
