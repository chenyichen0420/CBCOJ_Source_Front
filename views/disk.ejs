<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的网盘 - CBCOJ</title>
    <link rel="stylesheet" href="/assets/base.css">
    <link rel="stylesheet" href="/assets/components.css">
    <link rel="stylesheet" href="/assets/layout.css">
    <style>
        .disk-container { max-width: 900px; margin: 0 auto; padding: 20px; }
        .quota-card { background: var(--bg-secondary); padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        .quota-bar { background: #e0e0e0; border-radius: 10px; height: 20px; width: 100%; overflow: hidden; margin-top: 8px; }
        .quota-fill { background: var(--primary); width: 0%; height: 100%; }
        .file-list { width: 100%; border-collapse: collapse; }
        .file-list th, .file-list td { padding: 10px; text-align: left; border-bottom: 1px solid var(--border); }
        .upload-area { display: flex; gap: 10px; margin-bottom: 20px; align-items: center; flex-wrap: wrap; }
    </style>
</head>
<body>
    <nav>
        <div class="nav-left"><%- navigation %></div>
        <div class="nav-right">
            <div class="login-content">
                <div id="login-area"></div>
                <div id="login-status">
                    <div class="status-indicator" id="statusIndicator"></div>
                    <span id="statusText">正在检测登录状态...</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="page">
        <div class="container disk-container">
            <h1>我的网盘</h1>
            <div class="quota-card">
                <strong>磁盘使用情况</strong>
                <div id="quota-text">已使用 <%= (used / 1024 / 1024).toFixed(2) %> MB / 总配额 <%= (quota / 1024 / 1024).toFixed(2) %> MB</div>
                <div class="quota-bar"><div class="quota-fill" style="width: <%= (used / quota * 100).toFixed(2) %>%"></div></div>
            </div>
            <div class="upload-area">
                <input type="file" id="uploadFileInput" />
                <button class="btn btn-primary" id="uploadBtn">上传文件</button>
            </div>
            <div id="fileListContainer">
                <table class="file-list">
                    <thead><tr><th>文件名</th><th>大小(MB)</th><th>上传时间</th><th>操作</th></tr></thead>
                    <tbody>
                        <% if (files && files.length > 0) {
                            files.forEach(f => { %>
                                <tr>
                                    <td><a href="/api/disk/download/<%= f.id %>?cookie=<%= user ? user.cookie : '' %>"><%= f.filename %></a></td>
                                    <td><%= (f.file_size / 1024 / 1024).toFixed(2) %></td>
                                    <td><%= new Date(f.upload_time).toLocaleString() %></td>
                                    <td><button class="btn-sm btn-danger" onclick="deleteFile(<%= f.id %>)">删除</button></td>
                                </tr>
                            <% });
                        } else { %>
                            <tr><td colspan="4">暂无文件</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script type="text/javascript" src="/assets/checklogin.min.js"></script>
    <script>
        async function deleteFile(fileId) {
            if (!confirm('确定删除该文件吗？')) return;
            const cookie = getcookie();
            const resp = await fetch(`/api/disk/file/${fileId}?cookie=${cookie}`, { method: 'DELETE' });
            const data = await resp.json();
            if (data.status === 'Y') location.reload();
            else alert('删除失败：' + data.error);
        }
        document.getElementById('uploadBtn').addEventListener('click', async () => {
            const fileInput = document.getElementById('uploadFileInput');
            if (!fileInput.files.length) { alert('请选择文件'); return; }
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            const cookie = getcookie();
            const resp = await fetch(`/api/disk/upload?cookie=${cookie}`, { method: 'POST', body: formData });
            const data = await resp.json();
            if (data.status === 'Y') { alert('上传成功'); location.reload(); }
            else alert('上传失败：' + data.error);
        });
    </script>
</body>
</html>
